[Unit]
Description=Vise download manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/vise/daemon.env
ExecStart=%h/.cargo/bin/vise --daemon --bind 0.0.0.0:8080 --output %h/Downloads/vise --resume-all
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=120
SuccessExitStatus=130
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
